<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chatter.CQRS\src\Chatter.CQRS\Chatter.CQRS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Chatter.CQRS.nupkg embeds this analyzer only at pack time (see its packing target); a
      ProjectReference here doesn't pull it in automatically. Reference the built analyzer DLL
      directly - a real NuGet consumer referencing the published package gets it for free.
    -->
    <Analyzer Include="..\..\src\Chatter.SourceGenerators\src\Chatter.SourceGenerators\bin\$(Configuration)\netstandard2.0\Chatter.SourceGenerators.dll" />
  </ItemGroup>

</Project>
