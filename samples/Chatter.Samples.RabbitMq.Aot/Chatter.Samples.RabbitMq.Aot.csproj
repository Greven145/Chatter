<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chatter.CQRS\src\Chatter.CQRS\Chatter.CQRS.csproj" />
    <ProjectReference Include="..\..\src\Chatter.MessageBrokers\src\Chatter.MessageBrokers\Chatter.MessageBrokers.csproj" />
    <ProjectReference Include="..\..\src\Chatter.MessageBrokers.RabbitMQ\src\Chatter.MessageBrokers.RabbitMQ\Chatter.MessageBrokers.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Same reason as Chatter.Samples.Cqrs.csproj: Chatter.CQRS.nupkg only embeds this analyzer at
      pack time; a ProjectReference here wouldn't pull it in. A ProjectReference would also drag
      this netstandard2.0 analyzer project into this project's Native AOT publish graph and
      NETSDK1207-fail (same reasoning as Chatter.Aot.Smoke.Tests.csproj's identical workaround) -
      reference the built analyzer DLL directly instead.
    -->
    <Analyzer Include="..\..\src\Chatter.SourceGenerators\src\Chatter.SourceGenerators\bin\$(Configuration)\netstandard2.0\Chatter.SourceGenerators.dll" />
  </ItemGroup>

</Project>
